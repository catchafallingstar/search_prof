APP_ENV=production
DEV_AUTH_BYPASS=false
CONTACT_EMAIL=you@example.com

# Use the managed PostgreSQL provider's connection string in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

OPENALEX_EMAIL=you@example.com
OPENALEX_API_KEY=replace-with-your-free-openalex-key
TARGET_COUNTRY_CODE=US
RADAR_MAX_WORKERS=2
INDEX_VERIFY_BATCH_SIZE=2
INDEX_ENRICH_BATCH_SIZE=10
RADAR_WORKER_POLL_SECONDS=3
PUBLIC_TOPIC_HOURLY_LIMIT=20
FACULTY_VERIFY_OPENALEX_SUPPORT_ENABLED=false
ROLE_VERIFICATION_HOURLY_LIMIT=3
OPPORTUNITY_SUBMISSION_HOURLY_LIMIT=5
FACULTY_VERIFY_MAX_WORKERS=2
FACULTY_VERIFY_BATCH_SIZE=8
FACULTY_VERIFY_BUDGET_SECONDS=120
# Per-candidate search breadth and bounded career-move discovery.
FACULTY_VERIFY_RESULTS_PER_QUERY=5
FACULTY_VERIFY_MAX_QUERIES=5
FACULTY_VERIFY_MAX_PAGES=8
# Ceiling, not a promise of 100 results. LangSearch returns at most 10 per query.
FACULTY_IDENTITY_PASS_QUERIES=10
FACULTY_IDENTITY_PASS_RESULTS=100
FACULTY_IDENTITY_PASS_PAGES=20
FACULTY_IDENTITY_PASS_SECONDS=90
FACULTY_IDENTITY_VERBOSE_LOG=true
# PDF affiliation fallback. OCR runs only when an accessible PDF has no usable text.
PAPER_AFFILIATION_RETRY_DAYS=1
PAPER_PDF_OCR_ENABLED=true
PAPER_PDF_OCR_MAX_PAGES=2
PAPER_PDF_OCR_DPI=180
PAPER_PDF_OCR_TIMEOUT_SECONDS=20
PAPER_PDF_OCR_MIN_TEXT_CHARS=120
TESSERACT_CMD=
FACULTY_VERIFY_MAX_INSTITUTION_HINTS=1
FACULTY_MOVE_MAX_EXACT_NAME_RECORDS=8
# Optional, budgeted extraction for unresolved faculty identities. Begin with a
# low limit and monitor the staff dashboard before raising it.
GEMINI_IDENTITY_ENABLED=false
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_IDENTITY_MODEL=gemini-2.5-flash-lite
GEMINI_IDENTITY_DAILY_LIMIT=25
GEMINI_IDENTITY_TIMEOUT_SECONDS=20
GEMINI_IDENTITY_MAX_INPUT_CHARS=16000
GEMINI_IDENTITY_MIN_CONFIDENCE_PERCENT=85
HIRING_FIRST_RESULTS_PER_QUERY=10
ROTATING_PROXY_URL=
SEARCHAPI_API_KEY=
SEARCHAPI_TIMEOUT_SECONDS=20
SEARCHAPI_MIN_INTERVAL_MS=2000
SEARCHAPI_DAILY_LIMIT=100
SEARCHAPI_MONTHLY_LIMIT=100
SEARCHAPI_TOTAL_LIMIT=100
SEARCHAPI_MAX_CONCURRENCY=1
PARALLEL_API_KEY=
PARALLEL_TIMEOUT_SECONDS=20
PARALLEL_MIN_INTERVAL_MS=2000
PARALLEL_DAILY_LIMIT=100
PARALLEL_MONTHLY_LIMIT=100
PARALLEL_TOTAL_LIMIT=100
PARALLEL_MAX_CONCURRENCY=1
BRAVE_SEARCH_API_KEY=
BRAVE_STORAGE_ALLOWED=false
TAVILY_API_KEY=
TAVILY_ALLOW_PAID_USAGE=false
TAVILY_MIN_INTERVAL_MS=2000
TAVILY_DAILY_LIMIT=200
TAVILY_MONTHLY_LIMIT=1000
TAVILY_TOTAL_LIMIT=1000
BRAVE_MIN_INTERVAL_MS=2000
BRAVE_DAILY_LIMIT=200
BRAVE_MONTHLY_LIMIT=1000
BRAVE_TOTAL_LIMIT=1000
# Run SearXNG privately beside the always-on worker. Do not point a hosted
# worker at localhost unless SearXNG is running in that same service.
SEARXNG_URL=https://PRIVATE-SEARXNG-HOST
SEARXNG_ENGINES=google,bing
# LangSearch: blank key disables it. See docs/LANGSEARCH_SETUP.md.
LANGSEARCH_API_KEY=
LANGSEARCH_TIMEOUT_SECONDS=20
LANGSEARCH_MIN_INTERVAL_MS=2000
LANGSEARCH_DAILY_LIMIT=900
LANGSEARCH_MONTHLY_LIMIT=0
LANGSEARCH_TOTAL_LIMIT=0
LANGSEARCH_MAX_CONCURRENCY=1
SEARCH_PROVIDERS=langsearch,searchapi,parallel,tavily,brave,ddgs
SEARCH_PROVIDER_STRATEGY=fallback
SEARCH_PARALLEL_MAX_PROVIDERS=2
SEARCH_PROVIDER_TIMEOUT_SECONDS=8
SEARCH_PROVIDER_BACKOFF_SECONDS=3600
SEARCH_RATE_LIMIT_BACKOFF_SECONDS=3600
SEARCH_MIN_INTERVAL_MS=60000
SEARCH_DAILY_LIMIT=200
SEARCH_EMPTY_CACHE_HOURS=24
# Enable only while use complies with ORCID's non-commercial Public API terms.
ORCID_ENABLED=false
ORCID_ACCESS_TOKEN=
PAPER_AFFILIATION_OPENALEX_LOOKUP_ENABLED=false
SEARXNG_MAX_CONCURRENCY=1
DDGS_MAX_CONCURRENCY=1
BRAVE_MAX_CONCURRENCY=1
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_HOURS=168
PUBLIC_RADAR_ENABLED=true
PUBLIC_RADAR_MAX_PAPERS=8
PUBLIC_RADAR_CACHE_HOURS=24
PUBLIC_RADAR_HOURLY_LIMIT=30
PUBLIC_RADAR_TIMEOUT_SECONDS=55
# Hard deadline for a single indexing job (30-1800 seconds).
INDEX_JOB_TIMEOUT_SECONDS=300

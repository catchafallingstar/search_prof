APP_ENV=development
DEV_AUTH_BYPASS=true
DEV_USER_EMAIL=you@example.com
DEV_USER_NAME="Local Site Owner"
CONTACT_EMAIL=you@example.com

POSTGRES_DB=scholarradar
POSTGRES_USER=scholarradar_app
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://scholarradar_app:change-this-local-password@localhost:5432/scholarradar

OPENALEX_EMAIL=you@example.com
OPENALEX_API_KEY=replace-with-your-free-openalex-key
TARGET_COUNTRY_CODE=US
RADAR_MAX_WORKERS=2
INDEX_VERIFY_BATCH_SIZE=3
INDEX_ENRICH_BATCH_SIZE=10
RADAR_WORKER_POLL_SECONDS=3
PUBLIC_TOPIC_HOURLY_LIMIT=20
FACULTY_VERIFY_OPENALEX_SUPPORT_ENABLED=false
ROLE_VERIFICATION_HOURLY_LIMIT=3
OPPORTUNITY_SUBMISSION_HOURLY_LIMIT=5
FACULTY_VERIFY_MAX_WORKERS=3
FACULTY_VERIFY_BATCH_SIZE=8
FACULTY_VERIFY_BUDGET_SECONDS=120
# Per-candidate search breadth and bounded career-move discovery.
FACULTY_VERIFY_RESULTS_PER_QUERY=5
FACULTY_VERIFY_MAX_QUERIES=5
FACULTY_VERIFY_MAX_PAGES=8
# PDF affiliation fallback. OCR runs only when an accessible PDF has no usable text.
PAPER_AFFILIATION_RETRY_DAYS=1
PAPER_PDF_OCR_ENABLED=true
PAPER_PDF_OCR_MAX_PAGES=2
PAPER_PDF_OCR_DPI=180
PAPER_PDF_OCR_TIMEOUT_SECONDS=20
PAPER_PDF_OCR_MIN_TEXT_CHARS=120
TESSERACT_CMD=
FACULTY_VERIFY_MAX_INSTITUTION_HINTS=1
FACULTY_MOVE_MAX_EXACT_NAME_RECORDS=8
# Optional AI fallback. Rules and cached decisions run first, so this is never
# called once per candidate. Keep disabled until GEMINI_API_KEY is configured.
GEMINI_IDENTITY_ENABLED=false
GEMINI_API_KEY=
GEMINI_IDENTITY_MODEL=gemini-2.5-flash-lite
GEMINI_IDENTITY_DAILY_LIMIT=25
GEMINI_IDENTITY_TIMEOUT_SECONDS=20
GEMINI_IDENTITY_MAX_INPUT_CHARS=16000
GEMINI_IDENTITY_MIN_CONFIDENCE_PERCENT=85
HIRING_FIRST_RESULTS_PER_QUERY=10
# Do not put Proton VPN credentials or a VPN server address in this file.
# ScholarRadar pauses and retries when a source rate-limits it; it does not
# rotate consumer VPN addresses to bypass a source's access controls.
ROTATING_PROXY_URL=
BRAVE_SEARCH_API_KEY=
# Local SearXNG is started by `make start`. Different candidate queries are
# distributed between it and DDGS; each SearXNG query may aggregate engines.
SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_PORT=8080
SEARXNG_ENGINES=google,bing
SEARCH_PROVIDERS=searxng,ddgs
SEARCH_PROVIDER_STRATEGY=fallback
SEARCH_PARALLEL_MAX_PROVIDERS=2
SEARCH_PROVIDER_TIMEOUT_SECONDS=8
SEARCH_PROVIDER_BACKOFF_SECONDS=900
SEARCH_RATE_LIMIT_BACKOFF_SECONDS=3600
SEARCH_MIN_INTERVAL_MS=8000
SEARXNG_MAX_CONCURRENCY=1
DDGS_MAX_CONCURRENCY=1
BRAVE_MAX_CONCURRENCY=1
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_HOURS=24
PUBLIC_RADAR_ENABLED=true
PUBLIC_RADAR_MAX_PAPERS=8
PUBLIC_RADAR_CACHE_HOURS=24
PUBLIC_RADAR_HOURLY_LIMIT=30
PUBLIC_RADAR_TIMEOUT_SECONDS=55
# Maximum wall-clock time for one background job. The worker terminates and
# retries external-source work that exceeds this deadline.
INDEX_JOB_TIMEOUT_SECONDS=300
# OpenAlex requests share one PostgreSQL-backed pace and one circuit breaker
# across every worker process. A 429 pauses all discovery jobs without using up
# their retry attempts. The API key and email are configured near the top.
OPENALEX_MIN_INTERVAL_MS=500
OPENALEX_RATE_LIMIT_BACKOFF_SECONDS=3600
OPENALEX_NETWORK_BACKOFF_SECONDS=300
